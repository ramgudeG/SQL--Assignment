--15.Get employee details from employee table whose employee name is “John”.
SELECT * FROM EMPLOYEE
WHERE FIRST_NAME LIKE 'John';

--16.Get employee details from employee table whose employee name are “John” and “Roy”
SELECT * FROM EMPLOYEE 
