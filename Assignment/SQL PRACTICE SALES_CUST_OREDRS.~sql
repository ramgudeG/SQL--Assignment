--100.Does the customer who has placed the maximum number of orders have the maximum rating?--
WITH Customer_Order_Count AS (
    SELECT Cnum, COUNT(Onum) AS Order_Count
    FROM Orders
    GROUP BY Cnum
    ORDER BY Order_Count DESC
    FETCH FIRST 1 ROWS ONLY
),
Max_Rating AS (
    SELECT MAX(Rating) AS Max_Customer_Rating FROM Customers
)
SELECT 
    C.Cnum, C.Cname, C.Rating, 
    CASE 
        WHEN C.Rating = (SELECT Max_Customer_Rating FROM Max_Rating) 
        THEN 'YES' 
        ELSE 'NO' 
    END AS Has_Max_Rating
FROM Customers C
JOIN Customer_Order_Count CO ON C.Cnum = CO.Cnum;

