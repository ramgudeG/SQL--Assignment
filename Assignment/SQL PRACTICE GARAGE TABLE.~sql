CREATE TABLE Purchase (
    PID NUMBER PRIMARY KEY,      -- Purchase ID (Primary Key)
    VID NUMBER,                  -- Vendor ID (Foreign Key)
    SPID NUMBER,                 -- Spare Part ID (Foreign Key)
    PQTY NUMBER,                 -- Purchased Quantity
    SPRATE NUMBER(10,2),         -- Spare Part Rate
    SPGST NUMBER(10,2),          -- GST on Spare Part
    PDATE DATE,                  -- Purchase Date
    TRANCOST NUMBER(10,2),       -- Transportation Cost
    TOTAL NUMBER(10,2),          -- Total Cost
    RCV_EID NUMBER,              -- Received Employee ID (Foreign Key)
    
    -- Define Foreign Keys
    CONSTRAINT FK_VID FOREIGN KEY (VID) REFERENCES Vendors(VID),
    CONSTRAINT FK_SPID FOREIGN KEY (SPID) REFERENCES Sparepart(SPID),
    CONSTRAINT FK_RCV_EID FOREIGN KEY (RCV_EID) REFERENCES Employees(EID)
);

