WHERE S.COMM IS NULL OR S.COMM=0;


--Q38 write a query that totals no. of services  for each day and place the results in descending order
SELECT S.SER_DATE, COUNT(*) AS TOTAL_SERVICES 
FROM SER_DET S 
GROUP BY S.SER_DATE 
ORDER BY TOTAL_SERVICES DESC;

--Q39 Display the service details of those customer who belong from same city 
SELECT C.*
FROM CUSTOMER C JOIN SER_DET S 
ON C.CID = S.CID 
WHERE C.CADD IN (SELECT C.CADD FROM CUSTOMER C GROUP BY CADD HAVING COUNT(C.CID) > 1);

--Q40 write a query join customers table to itself to find all pairs of customers service by a single employee--
SELECT C1.CID AS CUSTOMER1, C2.CID AS CUSTOMER2, S.EID 
FROM SER_DET S JOIN CUSTOMER C1 
ON S.CID = C1.CID 
JOIN CUSTOMER C2 
ON S.CID = C2.CID 
WHERE C1.CID != C2.CID;

