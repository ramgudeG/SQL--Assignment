--Q.60 Difference between purchase date and used date of spare part.
SELECT S.SER_DATE-P.PDATE AS DIFF_MONTHS
FROM SER_DET S JOIN PURCHASE P
ON S.SPID=P.SPID;

SELECT P.SPID, SP.SPNAME,(S.SER_DATE - P.PDATE) AS DAYS_DIFF 
FROM PURCHASE P JOIN SPAREPART SP
JOIN SER_DET S
ON S.SPID=SP.SPID
ON P.SPID = S.SPID 
WHERE S.SER_DATE IS NOT NULL;


