--Q.1 List all the customers serviced.
SELECT DISTINCT C.* FROM CUSTOMER C,SER_DET S
WHERE C.CID=S.CID;

SELECT DISTINCT CID FROM SER_DET;

--Q.2 Customers who are not serviced.
SELECT DISTINCT C.* FROM CUSTOMER C 
LEFT JOIN SER_DET S
ON C.CID =S.CID
WHERE S.CID IS NULL;

SELECT CID FROM CUSTOMER WHERE CID NOT IN (SELECT DISTINCT CID FROM SER_DET);

--Q.3 Employees who have not received the commission.
SELECT E.* FROM EMPLOYEES E
JOIN SER_DET S
ON E.EID=S.EID
WHERE S.COMM = 0 OR S.COMM IS NULL;

SELECT EID FROM EMPLOYEES WHERE COMM IS NULL OR COMM = 0;

--Q.4 Name the employee who have maximum Commission.
SELECT * FROM
    (SELECT E.*,DENSE_RANK()OVER(ORDER BY S.COMM DESC)AS DRK FROM EMPLOYEES E
     JOIN SER_DET S
     ON E.EID=S.EID)
WHERE DRK=1;

SELECT E.* FROM EMPLOYEES E,SER_DET S WHERE S.EID=E.EID AND S.COMM =(SELECT MAX(S.COMM) FROM SER_DET S);

--Q.5 Show employee name and minimum commission amount received by an employee.
SELECT * FROM
    (SELECT E.*,S.COMM,DENSE_RANK()OVER(ORDER BY S.COMM ASC)AS DRK FROM EMPLOYEES E
     JOIN SER_DET S
     ON E.EID=S.EID)
WHERE DRK=1;

SELECT E.* FROM EMPLOYEES E,SER_DET S WHERE S.EID=E.EID AND S.COMM =(SELECT MIN(S.COMM) FROM SER_DET S);
--Q.6 Display the Middle record from any table.
SELECT * FROM
     (SELECT C.*,RANK()OVER(ORDER BY C.CID)AS RK
      FROM CUSTOMER C)
WHERE RK BETWEEN 3 AND 6;

SELECT * FROM (SELECT C.*, ROW_NUMBER() OVER (ORDER BY CID) AS RN FROM CUSTOMER C) 
WHERE RN = (SELECT CEIL(COUNT(*) / 2) FROM CUSTOMER C);


--Q.7 Display last 4 records of any table.
SELECT * FROM
     (SELECT C.*,RANK()OVER(ORDER BY C.CID DESC)AS RK
      FROM CUSTOMER C)
WHERE RK <=4; 
   
SELECT * FROM CUSTOMER
WHERE ROWNUM<=4
ORDER BY CID DESC;
--Q.8 Count the number of records without count function from any table.
SELECT MAX(ROWNUM) FROM CUSTOMER;

--Q.9 Delete duplicate records from "Ser_det" table on cid.(note Please rollback after execution).
DELETE FROM SER_DET 
WHERE ROWID NOT IN (SELECT MIN(ROWID) FROM SER_DET GROUP BY CID, SID);
