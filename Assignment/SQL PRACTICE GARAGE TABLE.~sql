--Write a query to get details of employee and provide rating on basis of  maximum services provide by employee.
--Note (rating should be like A,B,C,D)
SELECT E.EID,E.ENAME,COUNT(S.SID)AS TOTAL_SERVICES,
    CASE
      WHEN COUNT(S.SID)>=4 THEN 'A'
      WHEN COUNT(S.SID)>=3 THEN 'B'
      WHEN COUNT(S.SID)>=2 THEN 'A' 
      ELSE 'D'
      END AS RATING
FROM EMPLOYEES E JOIN SER_DET S
ON E.EID=S.EID
GROUP BY E.EID,E.ENAME;       
        
