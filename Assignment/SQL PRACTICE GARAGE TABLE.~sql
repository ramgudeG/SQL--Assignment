FROM EMPLOYEES E JOIN SER_DET S
ON E.EID=E.EID
WHERE E.EJOB IN ('PAINTER','FITTER')
GROUP BY E.ENAME,E.EJOB;

SELECT EJOB, COUNT(*) AS TOTAL_SERVICES 
FROM EMPLOYEES E JOIN SER_DET S ON E.EID = S.EID WHERE E.EJOB IN ('Painter', 'Fitter') GROUP BY EJOB;


--Q35 Display employee salary and as per highest  salary provide Grade to employee 
SELECT E.*,DENSE_RANK()OVER(ORDER BY E.ESAL DESC)
FROM EMPLOYEES E
WHERE ESAL IS NOT NULL;

SELECT E.EID, E.ENAME, E.ESAL, 
    CASE 
      WHEN E.ESAL >= 2000 THEN 'A' 
      WHEN E.ESAL >= 1500 THEN 'B' 
      WHEN E.ESAL >= 1000 THEN 'C'
      ELSE 'D' 
      END AS GRADE 
FROM EMPLOYEES E;

